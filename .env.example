# Rest Countries API key (server-side only — do not use NEXT_PUBLIC_)
# Get yours at: https://restcountries.com/sign-up
RESTCOUNTRIES_API_KEY=your_api_key_here

# Safety gate: when true (default), /api/countries will NOT call the live API.
# No mock data is returned — you'll see a message asking you to disable this flag.
# Set to false only when you intentionally want live REST Countries requests.
SAFE_MODE=true
